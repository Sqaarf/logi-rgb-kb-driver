[Unit]
Description=Restore Logitech G Pro keyboard colors
# The keyboard forgets software colors when it loses power and boots into its
# onboard rainbow. The udev rule starts this unit whenever the keyboard is plugged in;
# it also runs at login.
ConditionPathExists=%h/.config/gpro-rgb/profile
StartLimitIntervalSec=30
StartLimitBurst=10

[Service]
Type=oneshot
# Give the keyboard a moment to finish starting up after it's plugged in.
ExecStartPre=/usr/bin/sleep 1
ExecStart=/usr/bin/env gpro-rgb load %h/.config/gpro-rgb/profile
# The lighting interface can show up a little after the first hidraw node.
Restart=on-failure
RestartSec=1

[Install]
WantedBy=default.target
